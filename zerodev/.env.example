# Your ZeroDev project RPC for Arbitrum Sepolia (dashboard -> project -> RPC).
# Looks like https://rpc.zerodev.app/api/v3/<project-id>/chain/421614
ZERODEV_RPC=

# Private key that controls the user's smart account (the "dad" signer).
# Throwaway key only. This account never needs ETH.
PRIVATE_KEY=

# CoffeeShop address printed by `forge script script/Deploy.s.sol`
SHOP_ADDRESS=

# Optional, only for `npm run buy:usdc` (pay gas in tokens).
# ZeroDev's built-in ERC-20 paymaster only accepts USDC on mainnets.
# On testnet, create a self-funded ERC-20 paymaster in the dashboard first.
GAS_TOKEN=
ERC20_PAYMASTER_RPC=
